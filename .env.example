# Persistent SQLite storage. Mount this path on persistent disk in production.
DATABASE_PATH=.data/fablab.sqlite
# Exact public origin used by write-request origin checks.
APP_URL=http://localhost:3000
# Provision staff accounts with scripts/create-admin.cjs before listing them here.
ADMIN_EMAILS=
# Set true for HTTPS production; false only for local HTTP testing.
COOKIE_SECURE=false
