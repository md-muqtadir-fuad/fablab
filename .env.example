# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ── Notice board / admin content features ────────────────────────────────
# true = notice board, its admin pages and homepage notices are switched on.
# Leave false (or unset) on any deployment that is not ready for them.
ENABLE_ADMIN=true

# ── Database ─────────────────────────────────────────────────────────────
# Local SQLite file (default). Used on your PC and on a BUET server with a disk.
DATABASE_PATH=.data/fablab.sqlite
# To use Turso instead (e.g. for the Vercel demo), set both of these.
# DATABASE_URL=libsql://your-database-name.turso.io
# DATABASE_AUTH_TOKEN=

# ── Uploaded files (notice attachments) ──────────────────────────────────
# Local folder (default). Back it up together with the database.
STORAGE_DIR=storage
# On Vercel, create a Blob store and set this token there instead.
# BLOB_READ_WRITE_TOKEN=

# ── Site and staff ───────────────────────────────────────────────────────
# Exact public origin used by write-request origin checks.
APP_URL=http://localhost:3000
# Optional: emails that are always treated as admins (comma-separated).
# Admins created with `npm run db:setup` do not need to be listed here.
ADMIN_EMAILS=
# Set true for HTTPS production; false only for local HTTP testing.
COOKIE_SECURE=false
